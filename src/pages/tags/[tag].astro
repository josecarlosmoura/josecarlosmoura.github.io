---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { slugify } from '../../consts';
import { getPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      label: tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { label, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`Artigos sobre ${label}`} description={`Todos os artigos marcados com #${label}.`}>
  <p class="meta"><a href={`${base}/blog`}>← Todos os artigos</a></p>
  <h1>#{label}</h1>
  <ul class="post-list">
    {posts.map((post) => <li><PostCard post={post} /></li>)}
  </ul>
</BaseLayout>
