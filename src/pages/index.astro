---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_SUBTITLE, SITE_TAGLINE, SITE_DESCRIPTION, AUTHOR, SOCIAL } from '../consts';
import { getPosts, getTopicsWithPosts } from '../lib/blog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = await getPosts();
const topics = await getTopicsWithPosts();
const recent = posts.slice(0, 6);
---

<BaseLayout title={`${SITE_TITLE} | ${SITE_SUBTITLE}`} description={SITE_DESCRIPTION}>
  <section class="hero hero-photo">
    <img class="avatar-lg" src={`${base}${AUTHOR.photo}`} alt={`Foto de ${AUTHOR.name}`} width="160" height="160" />
    <div>
      <p class="eyebrow">{AUTHOR.role}</p>
      <h1>{SITE_TITLE}</h1>
      <p class="tagline">{SITE_TAGLINE}</p>
      <div class="btns">
        <a class="btn primary" href={`${base}/blog`}>Ler os artigos</a>
        <a class="btn" href={`${base}/sobre`}>Sobre mim</a>
        {SOCIAL.linkedin && <a class="btn" href={SOCIAL.linkedin} target="_blank" rel="me noopener">LinkedIn</a>}
        {SOCIAL.github && <a class="btn" href={SOCIAL.github} target="_blank" rel="me noopener">GitHub</a>}
      </div>
    </div>
  </section>

  {topics.length > 0 && (
    <>
      <h2 class="section">Assuntos</h2>
      <div class="topic-grid">
        {topics.map((t) => (
          <a class="card topic-card" href={`${base}/blog/${t.slug}/`}>
            <h3>{t.name}</h3>
            <p>{t.description}</p>
            <span class="meta">{t.posts.length} {t.posts.length === 1 ? 'artigo' : 'artigos'}</span>
          </a>
        ))}
      </div>
    </>
  )}

  <h2 class="section">Artigos recentes</h2>
  {recent.length === 0 ? (
    <p>Os primeiros artigos chegam em breve.</p>
  ) : (
    <ul class="post-list">
      {recent.map((post) => <li><PostCard post={post} /></li>)}
    </ul>
  )}
  {posts.length > recent.length && (
    <p style="margin-top:20px"><a href={`${base}/blog`}>Ver todos os artigos →</a></p>
  )}
</BaseLayout>
