---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, SOCIAL } from '../consts';
import { getTopicsWithPosts } from '../lib/blog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topics = await getTopicsWithPosts();
---

<BaseLayout title="Sobre" description={`${AUTHOR.name}: ${AUTHOR.role}. Conheça o autor do blog.`}>
  <div class="about">
    <img class="avatar-lg" src={`${base}${AUTHOR.photo}`} alt={`Foto de ${AUTHOR.name}`} width="160" height="160" />
    <div>
      <h1 style="margin:0 0 4px">Sobre</h1>
      <p class="meta" style="margin:0">{AUTHOR.role}</p>
    </div>
  </div>

  <div class="prose" style="margin-top:24px">
    <p><strong>Olá, eu sou {AUTHOR.name}.</strong></p>
    <p>{AUTHOR.bio}</p>
    <p>
      Este blog funciona como um caderno de estudos público: cada artigo transforma um conceito em um esquema, um
      resumo e, quando possível, um exemplo prático em código. Se algo estiver impreciso ou você tiver uma sugestão,
      será um prazer conversar.
    </p>
    {topics.length > 0 && (
      <>
        <h2>Sobre o que eu escrevo</h2>
        <ul>
          {topics.map((t) => (
            <li><a href={`${base}/blog/${t.slug}/`}>{t.name}</a>: {t.description}</li>
          ))}
        </ul>
      </>
    )}
  </div>

  <div class="btns" style="margin-top:24px">
    {SOCIAL.linkedin && <a class="btn primary" href={SOCIAL.linkedin} target="_blank" rel="me noopener">LinkedIn</a>}
    {SOCIAL.github && <a class="btn" href={SOCIAL.github} target="_blank" rel="me noopener">GitHub</a>}
    {SOCIAL.email && <a class="btn" href={`mailto:${SOCIAL.email}`}>E-mail</a>}
  </div>
</BaseLayout>
