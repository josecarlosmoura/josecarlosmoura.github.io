---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
