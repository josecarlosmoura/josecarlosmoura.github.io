---
import { AUTHOR, SOCIAL } from '../consts';
import { getTopicsWithPosts } from '../lib/blog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const topics = await getTopicsWithPosts();
---

<footer class="site-footer">
  <div class="wrap">
    {topics.length > 0 && (
      <nav class="footer-topics" aria-label="Assuntos">
        <strong>Assuntos:</strong>
        {topics.map((t) => <a href={`${base}/blog/${t.slug}/`}>{t.name}</a>)}
        <a href={`${base}/blog`}>Todos os artigos</a>
      </nav>
    )}
    <span>© {year} {AUTHOR.name}</span>
    <span>
      {SOCIAL.github && <a href={SOCIAL.github} rel="me noopener" target="_blank">GitHub</a>}
      {SOCIAL.linkedin && <> · <a href={SOCIAL.linkedin} rel="me noopener" target="_blank">LinkedIn</a></>}
      {SOCIAL.email && <> · <a href={`mailto:${SOCIAL.email}`}>E-mail</a></>}
      <> · <a href={`${base}/rss.xml`}>RSS</a></>
    </span>
  </div>
</footer>
