---
// Incorpora uma página HTML autônoma (guardada em /public) dentro do artigo.
// Ela roda isolada em um iframe, então o CSS e o JavaScript dela não afetam o blog.
interface Props {
  src: string; // caminho dentro de /public, ex.: /visuais/rag-passo-a-passo.html
  title: string;
}

const { src, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = `${base}${src}`;
---

<figure class="embed-wide">
  <iframe
    class="embed-frame"
    src={url}
    title={title}
    loading="lazy"
    scrolling="no"
    style="height: 900px"></iframe>
  <figcaption>
    Prefere ver em tela cheia? <a href={url} target="_blank" rel="noopener">Abrir em nova aba</a>
  </figcaption>
</figure>

<style>
  .embed-wide {
    width: min(1100px, calc(100vw - 32px));
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    margin: 32px 0 0;
  }
  .embed-wide iframe {
    display: block;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .embed-wide figcaption {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    text-align: center;
  }
  /* evita barra de rolagem horizontal por causa da largura extra */
  :global(main) { overflow-x: clip; }
</style>

<script>
  // Ajusta a altura do iframe ao conteúdo, para o artigo rolar como uma página só.
  const fit = (frame: HTMLIFrameElement) => {
    const body = frame.contentDocument?.body;
    if (!body) return;
    const h = Math.ceil(body.getBoundingClientRect().height);
    if (h > 0) frame.style.height = `${h}px`;
  };

  document.querySelectorAll<HTMLIFrameElement>('iframe.embed-frame').forEach((frame) => {
    let observer: ResizeObserver | undefined;
    const setup = () => {
      const body = frame.contentDocument?.body;
      if (!body) return;
      fit(frame);
      observer?.disconnect();
      observer = new ResizeObserver(() => fit(frame));
      observer.observe(body);
    };
    frame.addEventListener('load', setup);
    if (frame.contentDocument?.readyState === 'complete') setup();
  });
</script>
