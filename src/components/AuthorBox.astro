---
import { AUTHOR, SOCIAL } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="author-box" aria-label="Sobre o autor">
  <img src={`${base}${AUTHOR.photo}`} alt={`Foto de ${AUTHOR.name}`} width="72" height="72" loading="lazy" />
  <div>
    <strong>{AUTHOR.name}</strong>
    <span class="meta">{AUTHOR.role}</span>
    <p>{AUTHOR.bio}</p>
    <p>
      {SOCIAL.linkedin && <a href={SOCIAL.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
      {SOCIAL.github && <> · <a href={SOCIAL.github} rel="me noopener" target="_blank">GitHub</a></>}
      <> · <a href={`${base}/sobre`}>Mais sobre mim</a></>
    </p>
  </div>
</section>
